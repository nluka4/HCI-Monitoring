<Application x:Class="NetworkService.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <!-- ================= COLORS ================= -->
        <SolidColorBrush x:Key="UIBackgroundBrush" Color="#F4F4F4"/>
        <SolidColorBrush x:Key="UIPanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="UIPanelHeaderBrush" Color="#EFEFEF"/>
        <SolidColorBrush x:Key="UIPrimaryBrush" Color="#111111"/>
        <SolidColorBrush x:Key="UIBorderBrush" Color="#111111"/>
        <SolidColorBrush x:Key="UISubtleBorderBrush" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="UIMutedTextBrush" Color="#555555"/>
        <SolidColorBrush x:Key="UIInvalidBrush" Color="#333333"/>
        <SolidColorBrush x:Key="UIInvalidTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="UISelectedRowBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="UIHoverBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="UIFocusBrush" Color="#000000"/>
        <SolidColorBrush x:Key="UIWhiteBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="UIErrorBrush" Color="#7A1F1F"/>
		<SolidColorBrush x:Key="UIOverlayBrush" Color="#66000000"/>

        <!-- ================= FOCUS STYLE ================= -->
        <Style x:Key="KeyboardFocusStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="{StaticResource UIFocusBrush}"
                                   StrokeThickness="3"
                                   StrokeDashArray="1 0"
                                   Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= TEXT ================= -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        
        <Style x:Key="MonoLabelText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource UIMutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PanelTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource UIPrimaryBrush}"/>
        </Style>

        <Style x:Key="ErrorText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource UIErrorBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ================= BUTTONS ================= -->
        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource UIPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UIBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource UIHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource UISelectedRowBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource UIPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource UIWhiteBrush}"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource UIInvalidBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource UIInvalidTextBrush}"/>
        </Style>

        <!-- ================= INPUTS ================= -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UIBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UIBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- ================= PANEL ================= -->
        <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UIBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- ================= DATAGRID ================= -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UIBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource UIPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource UIWhiteBrush}"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource UIHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource UISelectedRowBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UIBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>