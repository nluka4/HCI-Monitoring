<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkService"
        xmlns:views="clr-namespace:NetworkService.Views"
        mc:Ignorable="d"
        Title="MainWindow"
        MinHeight="600"
        MinWidth="1200"
        Background="#E8E8E8">

    <Window.Resources>

        <!-- HEADER TEXT -->
        <Style TargetType="{x:Type TextBlock}" x:Key="HeaderText">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5,20"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
        </Style>

        <!-- GROUP LABEL -->
        <Style TargetType="{x:Type TextBlock}" x:Key="TabGroupDescription">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- TABCONTROL BEZ GORNJIH TABOVA -->
        <Style TargetType="{x:Type TabControl}" x:Key="ContentOnlyTabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Margin="0"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NAV RADIO BUTTON: ENTITIES / DISPLAY / GRAPH -->
        <Style TargetType="{x:Type RadioButton}" x:Key="SideNavRadioButton">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>

                                <Border x:Name="ShortcutBorder"
                                        Grid.Column="1"
                                        BorderBrush="{TemplateBinding Foreground}"
                                        BorderThickness="1.5"
                                        CornerRadius="5"
                                        Padding="8,4"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="Courier New"
                                               FontSize="18"
                                               FontWeight="DemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#111"/>
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#111"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMMAND BUTTON: BACK / UNDO / SHORTCUTS / TERMINAL -->
        <Style TargetType="{x:Type Button}" x:Key="SideCommandButton">
            <Setter Property="FontFamily" Value="Courier New"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,4"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="1"
                                        BorderBrush="#333"
                                        BorderThickness="1.5"
                                        CornerRadius="5"
                                        Padding="8,4"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="{TemplateBinding Tag}"
                                               Foreground="#333"
                                               FontFamily="Courier New"
                                               FontSize="18"
                                               FontWeight="DemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#E7E7E7"/>
                                <Setter TargetName="MainBorder" Property="BorderThickness" Value="3"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MainBorder" Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Background="#111"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch">

            <Border BorderThickness="2"
                    BorderBrush="White"
                    Margin="16"
                    Padding="4"
                    CornerRadius="5"
                    VerticalAlignment="Center">

                <TextBlock Style="{StaticResource HeaderText}"
                           Margin="0"
                           FontSize="24"
                           FontWeight="Black">
                    NS
                </TextBlock>
            </Border>

            <TextBlock Style="{StaticResource HeaderText}"
                       FontSize="24"
                       FontWeight="Black"
                       VerticalAlignment="Center">
                NetworkService
            </TextBlock>

            <TextBlock Style="{StaticResource HeaderText}"
                       FontSize="22"
                       VerticalAlignment="Center">
                · DER Monitoring
            </TextBlock>

            <TextBlock Style="{StaticResource HeaderText}"
                       FontSize="22"
                       VerticalAlignment="Center">
                · CG2/T4/G2/P1
            </TextBlock>

        </StackPanel>


        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="#E4E4E4"
                    BorderBrush="#111"
                    BorderThickness="0,0,2,0">

                <StackPanel Margin="0,22,0,0">

                    <TextBlock Style="{StaticResource TabGroupDescription}"
                               Margin="22,0,0,8">
                        VIEWS / KEYBOARD-FIRST
                    </TextBlock>

                    <RadioButton x:Name="EntitiesNav"
                                 Style="{StaticResource SideNavRadioButton}"
                                 GroupName="MainViews"
                                 Content="Entities"
                                 Tag="Alt+1"
                                 IsChecked="True"
                                 Checked="EntitiesNav_Checked"/>

                    <RadioButton x:Name="DisplayNav"
                                 Style="{StaticResource SideNavRadioButton}"
                                 GroupName="MainViews"
                                 Content="Display"
                                 Tag="Alt+2"
                                 Checked="DisplayNav_Checked"/>

                    <RadioButton x:Name="GraphNav"
                                 Style="{StaticResource SideNavRadioButton}"
                                 GroupName="MainViews"
                                 Content="Graph"
                                 Tag="Alt+3"
                                 Checked="GraphNav_Checked"/>


                    <TextBlock Style="{StaticResource TabGroupDescription}"
                               Margin="22,18,0,8">
                        GLOBAL ACTIONS
                    </TextBlock>

                    <Button Style="{StaticResource SideCommandButton}"
                            Content="Back"
                            Tag="Esc"
                            Click="BackButton_Click"/>

                    <Button Style="{StaticResource SideCommandButton}"
                            Content="Undo"
                            Tag="Ctrl+Z"
                            Click="UndoButton_Click"/>

                    <Button Style="{StaticResource SideCommandButton}"
                            Content="Shortcuts"
                            Tag="F1"
                            Click="ShortcutsButton_Click"/>

                    <Button Style="{StaticResource SideCommandButton}"
                            Content="Terminal"
                            Tag="Ctrl+`"
                            Click="TerminalButton_Click"/>

                </StackPanel>
            </Border>


            <!-- RIGHT CONTENT -->
            <TabControl x:Name="MainTabs"
                        Grid.Column="1"
                        Style="{StaticResource ContentOnlyTabControl}"
                        Background="#F4F4F4"
                        BorderThickness="0"
                        SelectedIndex="0" SelectionChanged="MainTabs_SelectionChanged">

                <!-- ENTITIES UI -->
                <TabItem>
                    <views:EntitiesUi/>
                </TabItem>


                <!-- DISPLAY UI -->
                <TabItem>
                    <Grid Background="White">
                    </Grid>
                </TabItem>


                <!-- GRAPH UI -->
                <TabItem>
                    <Grid Background="White">
                        <TextBlock Text="GRAPH UI"
                                   FontFamily="Courier New"
                                   FontSize="44"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>

            </TabControl>

        </Grid>
    </Grid>
</Window>