<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModel="clr-namespace:NetworkService.ViewModel"
        xmlns:views="clr-namespace:NetworkService.Views"
        Title="NetworkService"
        Height="850"
        Width="1400"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource UIBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        >

	<Window.Resources>
		<DataTemplate DataType="{x:Type viewModel:EntitiesViewModel}">
			<views:EntitiesUi/>
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewModel:NetworkDisplayViewModel}">
			<views:NetworkDisplayView/>
		</DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:GraphViewModel}">
            <views:GraphView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:PlaceholderViewModel}">
			<Grid Background="{StaticResource UIBackgroundBrush}" Margin="18">
				<Border Style="{StaticResource PanelBorderStyle}"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="620">
					<StackPanel>
						<TextBlock Text="{Binding Title}"
                                   FontFamily="Courier New"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

						<TextBlock Text="{Binding Description}"
                                   FontSize="15"
                                   Foreground="{StaticResource UIMutedTextBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="23"/>

						<Border BorderBrush="{StaticResource UISubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{StaticResource UIBackgroundBrush}"
                                Padding="12"
                                Margin="0,18,0,0">
							<TextBlock Text="This is only a temporary placeholder. The real Display and Graph views are added in the next steps."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource UIMutedTextBrush}"/>
						</Border>
					</StackPanel>
				</Border>
			</Grid>
		</DataTemplate>
	</Window.Resources>

	<Window.InputBindings>
		<KeyBinding Key="D1"
                    Modifiers="Alt"
                    Command="{Binding NavCommand}"
                    CommandParameter="entities"/>

		<KeyBinding Key="D2"
                    Modifiers="Alt"
                    Command="{Binding NavCommand}"
                    CommandParameter="display"/>

		<KeyBinding Key="D3"
                    Modifiers="Alt"
                    Command="{Binding NavCommand}"
                    CommandParameter="graph"/>

		<KeyBinding Key="Escape"
                    Command="{Binding BackCommand}"/>

		<KeyBinding Key="Z"
                    Modifiers="Control"
                    Command="{Binding UndoCommand}"/>

		<KeyBinding Key="F1"
                    Command="{Binding ToggleShortcutOverlayCommand}"/>

		<KeyBinding Key="Oem3"
                    Modifiers="Control"
                    Command="{Binding ToggleTerminalCommand}"/>
		<KeyBinding Key="F7"
            Command="{Binding NetworkDisplayViewModel.ToggleConnectionModeCommand}"/>
	</Window.InputBindings>

	<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="145" MinHeight="34" MaxHeight="320"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP BAR ================= -->
		<Border Grid.Row="0"
                Background="{StaticResource UIPrimaryBrush}"
                BorderBrush="{StaticResource UIBorderBrush}"
                BorderThickness="0,0,0,2">
			<DockPanel LastChildFill="False" Margin="18,0">
				<StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
					<Border Width="30"
                            Height="30"
                            BorderBrush="{StaticResource UIWhiteBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            Margin="0,0,12,0">
						<TextBlock Text="NS"
                                   Foreground="{StaticResource UIWhiteBrush}"
                                   FontFamily="Courier New"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
					</Border>

					<TextBlock Text="NetworkService · DER Monitoring · CG2/T4/G2/P1"
                               Foreground="{StaticResource UIWhiteBrush}"
                               FontFamily="Courier New"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
				</StackPanel>

				<StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
					<Border BorderBrush="{StaticResource UIWhiteBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4"
                            Margin="0,0,8,0">
						<TextBlock Text="log.txt WRITING"
                                   Foreground="{StaticResource UIWhiteBrush}"
                                   FontFamily="Courier New"
                                   FontSize="11"/>
					</Border>

					<Border BorderBrush="{StaticResource UIWhiteBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4"
                            Margin="0,0,8,0">
						<TextBlock Text="TCP :25675"
                                   Foreground="{StaticResource UIWhiteBrush}"
                                   FontFamily="Courier New"
                                   FontSize="11"/>
					</Border>

					<Border BorderBrush="{StaticResource UIWhiteBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8,4">
						<TextBlock Text="Palette: grayscale"
                                   Foreground="{StaticResource UIWhiteBrush}"
                                   FontFamily="Courier New"
                                   FontSize="11"/>
					</Border>
				</StackPanel>
			</DockPanel>
		</Border>

		<!-- ================= MAIN AREA ================= -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="245"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ================= SIDEBAR ================= -->
			<Border Grid.Column="0"
                    Background="#E7E7E7"
                    BorderBrush="{StaticResource UIBorderBrush}"
                    BorderThickness="0,0,2,0"
                    Padding="10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0">
						<TextBlock Text="VIEWS / KEYBOARD-FIRST"
                                   Style="{StaticResource MonoLabelText}"
                                   Margin="0,0,0,8"/>

						<Button Command="{Binding NavCommand}"
                                CommandParameter="entities"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Open Network Entities View"
                                Margin="0,0,0,8">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Entities"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="Alt+1" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>

						<Button Command="{Binding NavCommand}"
                                CommandParameter="display"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Open Network Display View"
                                Margin="0,0,0,8">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Display"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="Alt+2" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>

						<Button Command="{Binding NavCommand}"
                                CommandParameter="graph"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Open Measurement Graph View">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Graph"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="Alt+3" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>
					</StackPanel>

					<StackPanel Grid.Row="1" Margin="0,22,0,0">
						<TextBlock Text="GLOBAL ACTIONS"
                                   Style="{StaticResource MonoLabelText}"
                                   Margin="0,0,0,8"/>

						<Button Command="{Binding BackCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Return to previous View"
                                Margin="0,0,0,8">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Back"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="Esc" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>

						<Button Command="{Binding UndoCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Undo last command"
                                Margin="0,0,0,8">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Undo"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="Ctrl+Z" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>

						<Button Command="{Binding ToggleShortcutOverlayCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Show keyboard shortcuts"
                                Margin="0,0,0,8">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Shortcuts"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="F1" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>

						<Button Command="{Binding ToggleTerminalCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                ToolTip="Collapse or expand mini-terminal">
							<DockPanel LastChildFill="False">
								<TextBlock Text="Terminal"/>
								<Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,1"
                                        Margin="30,0,0,0">
									<TextBlock Text="Ctrl+`" FontSize="10"/>
								</Border>
							</DockPanel>
						</Button>
					</StackPanel>

					<Border Grid.Row="3"
                            BorderBrush="{StaticResource UISubtleBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
						<TextBlock Text="SCADA-style shell&#x0a;Keyboard-first interface for Linux power users. Use shortcuts or mini-terminal commands."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource UIMutedTextBrush}"
                                   FontSize="12"
                                   LineHeight="18"/>
					</Border>
				</Grid>
			</Border>

			<!-- ================= ACTIVE VIEW ================= -->
			<ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}"/>
		</Grid>

        <!-- ================= TERMINAL RESIZER ================= -->
        <GridSplitter Grid.Row="2"
              Height="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="{StaticResource UIPrimaryBrush}"
              ResizeDirection="Rows"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="False"
              Cursor="SizeNS"
              ToolTip="Drag up or down to resize the terminal"/>

        <!-- ================= MINI TERMINAL ================= -->
		<Border Grid.Row="3"
                Background="{StaticResource UIPrimaryBrush}"
                BorderBrush="{StaticResource UIBorderBrush}"
                BorderThickness="0,2,0,0">
			

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="32"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<DockPanel Grid.Row="0"
                           LastChildFill="False"
                           Margin="12,0">
					<TextBlock DockPanel.Dock="Left"
                               Text="TERMINAL · operator@networkservice:~$"
                               Foreground="{StaticResource UIWhiteBrush}"
                               FontFamily="Courier New"
                               FontSize="12"
                               VerticalAlignment="Center"/>

					<TextBlock DockPanel.Dock="Right"
                               Text="try: help, list, nav graph, search solar, undo"
                               Foreground="{StaticResource UIWhiteBrush}"
                               FontFamily="Courier New"
                               FontSize="11"
                               Opacity="0.85"
                               VerticalAlignment="Center"/>
				</DockPanel>

				<Grid Grid.Row="1" Margin="12,4,12,8">
					<Grid.Style>
						<Style TargetType="{x:Type Grid}">
							<Setter Property="Visibility" Value="Visible"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsTerminalExpanded}" Value="False">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Grid.Style>

					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="360"/>
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
                            BorderBrush="{StaticResource UIWhiteBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8"
                            Margin="0,0,10,0">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<TextBlock Text="{Binding TerminalOutput}"
                                       Foreground="{StaticResource UIWhiteBrush}"
                                       FontFamily="Courier New"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
						</ScrollViewer>
					</Border>

                    <TextBox x:Name="TerminalInputTextBox"
         Grid.Column="1"
         Text="{Binding TerminalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Background="{StaticResource UIPrimaryBrush}"
         Foreground="{StaticResource UIWhiteBrush}"
         BorderBrush="{StaticResource UIWhiteBrush}"
         CaretBrush="{StaticResource UIWhiteBrush}"
         FontFamily="Courier New"
         ToolTip="Mini-terminal command input"
         PreviewKeyDown="TerminalInputTextBox_PreviewKeyDown">
                        <TextBox.InputBindings>
							<KeyBinding Key="Enter"
                                        Command="{Binding ExecuteTerminalCommand}"/>
						</TextBox.InputBindings>
					</TextBox>
				</Grid>
			</Grid>
		</Border>

		<!-- ================= SHORTCUTS OVERLAY ================= -->
        <Border Grid.Row="0"
        Grid.RowSpan="4"
        Panel.ZIndex="900"
        Background="{StaticResource UIOverlayBrush}">
            <Border.Style>
				<Style TargetType="{x:Type Border}">
					<Setter Property="Visibility" Value="Collapsed"/>
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsShortcutOverlayVisible}" Value="True">
							<Setter Property="Visibility" Value="Visible"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>

			<Border Width="460"
                    Background="{StaticResource UIPanelBrush}"
                    BorderBrush="{StaticResource UIBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,76,24,0">
				<StackPanel>
					<TextBlock Text="Keyboard shortcuts"
                               FontFamily="Courier New"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

					<TextBlock Text="Alt+1  → Entities View" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Alt+2  → Display View" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Alt+3  → Graph View" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Esc    → Back / close overlay" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Ctrl+Z → Undo last command" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="F1     → Show / hide shortcuts" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Ctrl+` → Toggle mini-terminal" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Alt+Enter → Add entity" FontFamily="Courier New" Margin="0,3"/>
					<TextBlock Text="Alt+C → Clear filters" FontFamily="Courier New" Margin="0,3"/>

					<Button Content="Close"
                            Command="{Binding ToggleShortcutOverlayCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"/>
				</StackPanel>
			</Border>
		</Border>

		<!-- ================= TOAST ================= -->
        <!-- ================= TOAST ================= -->
        <Border Grid.Row="0"
        Grid.RowSpan="4"
        Panel.ZIndex="1000"
        Width="380"
        Background="{StaticResource UIPanelBrush}"
        BorderBrush="{StaticResource UIBorderBrush}"
        BorderThickness="2"
        CornerRadius="10"
        Padding="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,24,24"
        IsHitTestVisible="{Binding IsToastVisible}"
        Opacity="0">

            <Border.RenderTransform>
                <TranslateTransform X="430"/>
            </Border.RenderTransform>

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsToastVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="0:0:0.22"/>

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0"
                                                 Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>

                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0"
                                                 Duration="0:0:0.22"/>

                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="430"
                                                 Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STATUS COLOR BAR -->
                <Border Grid.Column="0"
                CornerRadius="8,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource UIToastInfoBrush}"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastType}" Value="SUCCESS">
                                    <Setter Property="Background" Value="{StaticResource UIToastSuccessBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ToastType}" Value="WARNING">
                                    <Setter Property="Background" Value="{StaticResource UIToastWarningBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ToastType}" Value="ERROR">
                                    <Setter Property="Background" Value="{StaticResource UIToastErrorBrush}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding ToastType}" Value="INFO">
                                    <Setter Property="Background" Value="{StaticResource UIToastInfoBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- CONTENT -->
                <StackPanel Grid.Column="1"
                    Margin="14,12,14,12">

                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding ToastTitle}"
                           FontFamily="Courier New"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource UIPrimaryBrush}"
                           DockPanel.Dock="Left"/>

                        <Border DockPanel.Dock="Right"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="5,1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource UIToastInfoBrush}"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastType}" Value="SUCCESS">
                                            <Setter Property="BorderBrush" Value="{StaticResource UIToastSuccessBrush}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ToastType}" Value="WARNING">
                                            <Setter Property="BorderBrush" Value="{StaticResource UIToastWarningBrush}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ToastType}" Value="ERROR">
                                            <Setter Property="BorderBrush" Value="{StaticResource UIToastErrorBrush}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ToastType}" Value="INFO">
                                            <Setter Property="BorderBrush" Value="{StaticResource UIToastInfoBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <TextBlock Text="{Binding ToastType}"
                               FontFamily="Courier New"
                               FontSize="10"
                               FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource UIToastInfoBrush}"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToastType}" Value="SUCCESS">
                                                <Setter Property="Foreground" Value="{StaticResource UIToastSuccessBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ToastType}" Value="WARNING">
                                                <Setter Property="Foreground" Value="{StaticResource UIToastWarningBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ToastType}" Value="ERROR">
                                                <Setter Property="Foreground" Value="{StaticResource UIToastErrorBrush}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ToastType}" Value="INFO">
                                                <Setter Property="Foreground" Value="{StaticResource UIToastInfoBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <TextBlock Text="{Binding ToastMessage}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource UIMutedTextBrush}"
                       FontSize="13"
                       LineHeight="18"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>