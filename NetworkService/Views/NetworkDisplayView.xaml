<UserControl x:Class="NetworkService.Views.NetworkDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="clr-namespace:NetworkService.Model"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:infra="clr-namespace:NetworkService.Infrastructure"
             xmlns:controls="clr-namespace:NetworkService.Controls"
             Background="{StaticResource UIBackgroundBrush}">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="VmProxy"
                            Data="{Binding}"/>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Network Display View"
                           FontFamily="Courier New"
                           FontSize="22"
                           FontWeight="Bold"/>

                <TextBlock Text="TreeView grouped by DER type, 12 canvas slots, drag &amp; drop and entity connections."
                           Foreground="{StaticResource UIMutedTextBrush}"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Command="{Binding AutoPlaceAllCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        ToolTip="Automatically place available entities into free slots"
                        Margin="8,0,0,0">
                    <TextBlock Text="Auto Place All"/>
                </Button>

                <Button Command="{Binding ToggleConnectionModeCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Toggle connection mode"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ConnectionModeText}"/>
                        <Border BorderBrush="{StaticResource UIWhiteBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,1"
                                Margin="8,0,0,0">
                            <TextBlock Text="F7" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ClearCanvasCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        ToolTip="Remove all entities and connections from canvas"
                        Margin="8,0,0,0">
                    <TextBlock Text="Clear canvas"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TREEVIEW PANEL -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource UIPanelHeaderBrush}"
                            BorderBrush="{StaticResource UIBorderBrush}"
                            BorderThickness="0,0,0,1.5"
                            CornerRadius="10,10,0,0"
                            Padding="12,10">
                        <DockPanel>
                            <TextBlock Text="TreeView · available entities"
                                       Style="{StaticResource PanelTitleText}"/>

                            <Border DockPanel.Dock="Right"
                                    BorderBrush="{StaticResource UIPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2">
                                <TextBlock Text="Drag"
                                           FontFamily="Courier New"
                                           FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <TreeView Grid.Row="1"
                              x:Name="EntitiesTreeView"
                              ItemsSource="{Binding TreeViewGroups}"
                              Background="{StaticResource UIPanelBrush}"
                              BorderThickness="0"
                              Margin="10">

                        <TreeView.Resources>

                            <HierarchicalDataTemplate DataType="{x:Type model:DERGroup}"
                                                      ItemsSource="{Binding Entities}">
                                <TextBlock Text="{Binding GroupName}"
                                           FontFamily="Courier New"
                                           FontWeight="Bold"
                                           Margin="0,6,0,6"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type model:DER}">
                                <Border BorderBrush="{StaticResource UIBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Background="{StaticResource UIPanelBrush}"
                                        Padding="8"
                                        Margin="0,4"
                                        Cursor="Hand">

                                    <i:Interaction.Behaviors>
                                        <infra:DragSourceBehavior/>
                                    </i:Interaction.Behaviors>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="32"
                                                Height="32"
                                                BorderBrush="{StaticResource UIBorderBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="5">
                                            <TextBlock Text="DER"
                                                       FontFamily="Courier New"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="12"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id, Mode=OneWay}"
                                                           FontFamily="Courier New"
                                                           FontSize="11"
                                                           Foreground="{StaticResource UIMutedTextBrush}"/>

                                                <TextBlock Text=" · "
                                                           FontFamily="Courier New"
                                                           FontSize="11"
                                                           Foreground="{StaticResource UIMutedTextBrush}"/>

                                                <TextBlock Text="{Binding TypeName, Mode=OneWay}"
                                                           FontFamily="Courier New"
                                                           FontSize="11"
                                                           Foreground="{StaticResource UIMutedTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource UISubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource UIBackgroundBrush}"
                            Padding="10"
                            Margin="10">
                        <TextBlock Text="Drag from TreeView to a free slot. When placed, entity disappears from TreeView. Drag an occupied card to another free slot. Use × to return it."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource UIMutedTextBrush}"
                                   FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- CANVAS PANEL -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource UIPanelHeaderBrush}"
                            BorderBrush="{StaticResource UIBorderBrush}"
                            BorderThickness="0,0,0,1.5"
                            CornerRadius="10,10,0,0"
                            Padding="12,10">
                        <DockPanel>
                            <TextBlock Text="DER network canvas"
                                       Style="{StaticResource PanelTitleText}"/>

                            <Border DockPanel.Dock="Right"
                                    BorderBrush="{StaticResource UIPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2">
                                <TextBlock Text="{Binding ConnectionModeText}"
                                           FontFamily="Courier New"
                                           FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          x:Name="CanvasArea"
                          Background="{StaticResource UIBackgroundBrush}"
                          Margin="12">

                        <ItemsControl x:Name="SlotsItemsControl"
                                      ItemsSource="{Binding CanvasSlots}"
                                      Panel.ZIndex="1">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="3" Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="SlotBorder"
                                            Tag="{Binding Index}"
                                            Margin="6"
                                            BorderThickness="2"
                                            CornerRadius="10"
                                            Background="{StaticResource UIPanelBrush}">

                                        <i:Interaction.Behaviors>
                                            <infra:DropTargetBehavior
                                                Command="{Binding Data.PlaceEntityCommand, Source={StaticResource VmProxy}}"/>

                                            <infra:MouseCommandBehavior
                                                Command="{Binding Data.SelectSlotForConnectionCommand, Source={StaticResource VmProxy}}"
                                                UseSlotIndexParameter="True"
                                                MarkHandled="True"/>
                                        </i:Interaction.Behaviors>

                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource UISubtleBorderBrush}"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasInvalidEntity}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource UIInvalidBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource UIPrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid Margin="8">

                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                       FontFamily="Courier New"
                                                       FontSize="10"
                                                       Foreground="{StaticResource UIMutedTextBrush}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"/>

                                            <TextBlock Text="free canvas"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource UIMutedTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border x:Name="EntityCard"
                                                    BorderBrush="{StaticResource UIPrimaryBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Background="{StaticResource UIPanelBrush}"
                                                    Padding="8"
                                                    Margin="0,18,0,0"
                                                    Cursor="Hand">

                                                <i:Interaction.Behaviors>
                                                    <infra:DragSourceBehavior UseSlotEntityAsDragData="True"/>
                                                </i:Interaction.Behaviors>

                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding HasInvalidEntity}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource UIInvalidBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="32"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="34"
                                                            Height="34"
                                                            BorderBrush="{StaticResource UIPrimaryBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="5"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="DER"
                                                                   FontFamily="Courier New"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Margin="4,0,4,0">

                                                        <TextBlock Text="{Binding Entity.Name, Mode=OneWay}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="#"
                                                                       FontFamily="Courier New"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource UIMutedTextBrush}"/>

                                                            <TextBlock Text="{Binding Entity.Id, Mode=OneWay}"
                                                                       FontFamily="Courier New"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource UIMutedTextBrush}"/>

                                                            <TextBlock Text=" · "
                                                                       FontFamily="Courier New"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource UIMutedTextBrush}"/>

                                                            <TextBlock Text="{Binding Entity.FormattedMeasurement, Mode=OneWay}"
                                                                       FontFamily="Courier New"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource UIMutedTextBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Entity.StatusText, Mode=OneWay}"
                                                                   FontFamily="Courier New"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Content="×"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip="Return entity to TreeView">

                                                        <i:Interaction.Behaviors>
                                                            <infra:MouseCommandBehavior
                                                                UsePreviewEvent="True"
                                                                MarkHandled="True"
                                                                Command="{Binding Data.ClearSlotCommand, Source={StaticResource VmProxy}}"/>
                                                        </i:Interaction.Behaviors>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:ConnectionLinesControl
                            Connections="{Binding Connections}"
                            CanvasSlots="{Binding CanvasSlots}"
                            Rows="3"
                            Columns="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"
                            Panel.ZIndex="50"/>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource UISubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="{StaticResource UIBackgroundBrush}"
                            Padding="10"
                            Margin="12">
                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource UIMutedTextBrush}"
                                   FontFamily="Courier New"
                                   FontSize="12"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>