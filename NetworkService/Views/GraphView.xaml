<UserControl x:Class="NetworkService.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NetworkService.Controls"
             Background="{StaticResource UIBackgroundBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Measurement Graph View"
                           FontFamily="Courier New"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock Text="G2 bar chart: last five received measurements for the selected DER entity."
                           Foreground="{StaticResource UIMutedTextBrush}"
                           FontSize="13"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource BaseButtonStyle}"
                    ToolTip="Manually refresh graph from log.txt"
                    Margin="8,0,0,0">
                <TextBlock Text="Refresh graph"/>
            </Button>
        </DockPanel>

        <!-- CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT CONTROL PANEL -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource UIPanelHeaderBrush}"
                            BorderBrush="{StaticResource UIBorderBrush}"
                            BorderThickness="0,0,0,1.5"
                            CornerRadius="10,10,0,0"
                            Padding="12,8">
                        <DockPanel>
                            <TextBlock Text="Graph controls"
                                       Style="{StaticResource PanelTitleText}"/>

                            <Border DockPanel.Dock="Right"
                                    BorderBrush="{StaticResource UIPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2">
                                <TextBlock Text="ComboBox"
                                           FontFamily="Courier New"
                                           FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="12">
                        <TextBlock Text="Choose entity"
                                   Style="{StaticResource MonoLabelText}"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding EntityOptions}"
                                  SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Choose entity for G2 bar chart"
                                  Margin="0,0,0,14"/>

                        <Border Style="{StaticResource PanelBorderStyle}"
                                Padding="10"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding LatestMeasurementText}"
                                           FontFamily="Courier New"
                                           FontSize="24"
                                           FontWeight="Bold"/>

                                <TextBlock Text="LATEST MEASUREMENT"
                                           Style="{StaticResource MonoLabelText}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource UISubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="{StaticResource UIBackgroundBrush}"
                                Padding="10"
                                Margin="0,0,0,12">
                            <TextBlock Text="Valid DER production range is 1-5 MW. Valid bars are medium gray. Invalid bars are dark gray."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource UIMutedTextBrush}"
                                       FontSize="12"/>
                        </Border>

                        <TextBlock Text="Legend"
                                   Style="{StaticResource MonoLabelText}"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Rectangle Width="28"
                                       Height="14"
                                       Stroke="{StaticResource UIBorderBrush}"
                                       Fill="#888888"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Valid 1-5 MW"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="28"
                                       Height="14"
                                       Stroke="{StaticResource UIBorderBrush}"
                                       Fill="#222222"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Invalid"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT CHART PANEL -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource UIPanelHeaderBrush}"
                            BorderBrush="{StaticResource UIBorderBrush}"
                            BorderThickness="0,0,0,1.5"
                            CornerRadius="10,10,0,0"
                            Padding="12,8">
                        <DockPanel>
                            <TextBlock Text="{Binding ChartTitle}"
                                       Style="{StaticResource PanelTitleText}"/>

                            <Border DockPanel.Dock="Right"
                                    BorderBrush="{StaticResource UIPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2">
                                <TextBlock Text="No Chart control"
                                           FontFamily="Courier New"
                                           FontSize="10"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="12"
                            BorderBrush="{StaticResource UIBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="10"
                            Background="{StaticResource UIPanelBrush}">
                        <controls:MeasurementBarChart
    Measurements="{Binding LastFiveMeasurements}"
    Background="{StaticResource UIPanelBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>