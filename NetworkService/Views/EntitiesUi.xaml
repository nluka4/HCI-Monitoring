<UserControl x:Class="NetworkService.Views.EntitiesUi"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource UIBackgroundBrush}"
             xmlns:infra="clr-namespace:NetworkService.Infrastructure">

    <UserControl.InputBindings>
        <KeyBinding Key="Enter"
                Modifiers="Alt"
                Command="{Binding AddCommand}" />

        <KeyBinding Key="C"
                Modifiers="Alt"
                Command="{Binding ClearFiltersCommand}" />

        <KeyBinding Key="Delete"
                Command="{Binding DeleteCommand}" />
        <KeyBinding Gesture="Ctrl+F"
                Command="{Binding RequestSearchFocusCommand}"/>

        <KeyBinding Gesture="Alt+A"
                Command="{Binding RequestAddFormFocusCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER ================= -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Network Entities View"
                               FontFamily="Courier New"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource UIPrimaryBrush}"/>

                    <TextBlock Text="Table, inline validation, P1 search, add/delete DER entities."
                               Foreground="{StaticResource UIMutedTextBrush}"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            ToolTip="Clear search and filters"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Clear filters"/>
                            <Border BorderBrush="{StaticResource UIPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="8,0,0,0">
                                <TextBlock Text="Alt+C" FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RequestAddFormFocusCommand}"
        Style="{StaticResource PrimaryButtonStyle}"
        ToolTip="Focus Add Entity form"
        Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Add Entity"/>
                            <Border BorderBrush="{StaticResource UIWhiteBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,1"
                                    Margin="8,0,0,0">
                                <TextBlock Text="Alt+Enter" FontSize="10"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- ================= METRICS ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="8"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalCount}"
                                   FontFamily="Courier New"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text="TOTAL ENTITIES"
                                   Style="{StaticResource MonoLabelText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="8"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ValidCount}"
                                   FontFamily="Courier New"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text="VALID 1-5 MW"
                                   Style="{StaticResource MonoLabelText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="8"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding InvalidCount}"
                                   FontFamily="Courier New"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text="INVALID ALERTS"
                                   Style="{StaticResource MonoLabelText}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource PanelBorderStyle}"
                        Padding="8">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayedCount}"
                                   FontFamily="Courier New"
                                   FontSize="24"
                                   FontWeight="Bold"/>
                        <TextBlock Text="DISPLAYED ROWS"
                                   Style="{StaticResource MonoLabelText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= MAIN CONTENT ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT PANEL ================= -->
                <Border Grid.Column="0"
                        Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource UIPanelHeaderBrush}"
                                BorderBrush="{StaticResource UIBorderBrush}"
                                BorderThickness="0,0,0,1.5"
                                CornerRadius="10,10,0,0"
                                Padding="12,10">
                            <DockPanel>
                                <TextBlock Text="Entity registry"
                                           Style="{StaticResource PanelTitleText}"/>

                                <Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,2">
                                    <TextBlock Text="P1"
                                               FontFamily="Courier New"
                                               FontSize="10"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- toolbar -->
                        <!-- toolbar -->
                        <Grid Grid.Row="1" Margin="10">
                            <Border BorderBrush="{StaticResource UISubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{StaticResource UIBackgroundBrush}"
            Padding="8">
                                <StackPanel>
                                    <TextBlock Text="P1 Search by"
                       Style="{StaticResource MonoLabelText}"
                       Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton Content="naziv"
                             IsChecked="{Binding SearchByName, Mode=TwoWay}"
                             ToolTip="Search by entity name"/>

                                        <RadioButton Content="tip"
                             IsChecked="{Binding SearchByType, Mode=TwoWay}"
                             ToolTip="Search by entity type"/>
                                    </StackPanel>

                                    <TextBox x:Name="SearchTextBox"
         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         infra:FocusRequest.FocusOnLoaded="True"
         infra:FocusRequest.Token="{Binding SearchFocusToken}"
         infra:FocusRequest.CaretToEnd="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- table -->
                        <DataGrid Grid.Row="2"
          Margin="10,0,10,8"
          ItemsSource="{Binding DisplayedEntities}"
          SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
          HeadersVisibility="Column"
          RowHeight="36"
          ColumnHeaderHeight="34"
          HorizontalGridLinesBrush="{StaticResource UISubtleBorderBrush}"
          VerticalGridLinesBrush="{StaticResource UISubtleBorderBrush}">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{StaticResource UIPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource UIWhiteBrush}"/>
                                    <Setter Property="FontFamily" Value="Courier New"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}"
                                       BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMeasurementValid}" Value="False">
                                            <Setter Property="Background" Value="{StaticResource UIInvalidBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource UIInvalidTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding Id}"
                                                    Width="70"/>

                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="*"/>

                                <DataGridTemplateColumn Header="Type" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding ImagePath}"
                                                       Width="24"
                                                       Height="24"
                                                       Margin="0,0,8,0"/>

                                                <TextBlock Text="{Binding TypeName}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Last Value"
                                                    Binding="{Binding FormattedMeasurement}"
                                                    Width="120"/>

                                <DataGridTemplateColumn Header="Status" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource UIBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Background" Value="{StaticResource UIPanelBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMeasurementValid}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource UIPrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock Text="{Binding StatusText}"
                                                           FontFamily="Courier New"
                                                           FontSize="11"
                                                           FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Foreground" Value="{StaticResource UIPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMeasurementValid}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource UIWhiteBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- table footer -->
                        <DockPanel Grid.Row="3"
                                   Margin="12,0,12,12">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource UIMutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="No selected entity."/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntity}" Value="{x:Null}">
                                                <Setter Property="Text" Value="No selected entity."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Delete selected entity after confirmation">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Delete selected"/>
                                    <Border BorderBrush="{StaticResource UIWhiteBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="Del" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- ================= RIGHT ADD PANEL ================= -->
                <Border Grid.Column="2"
                        Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource UIPanelHeaderBrush}"
                                BorderBrush="{StaticResource UIBorderBrush}"
                                BorderThickness="0,0,0,1.5"
                                CornerRadius="10,10,0,0"
                                Padding="12,10">
                            <DockPanel>
                                <TextBlock Text="Add DER Entity"
                                           Style="{StaticResource PanelTitleText}"/>

                                <Border DockPanel.Dock="Right"
                                        BorderBrush="{StaticResource UIPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="5,2">
                                    <TextBlock Text="Inline validation"
                                               FontFamily="Courier New"
                                               FontSize="10"/>
                                </Border>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="10">
                                <TextBlock Text="ID*"
                                       Style="{StaticResource MonoLabelText}"/>
                                <TextBox x:Name="AddIdTextBox"
         Text="{Binding FormEntity.Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         infra:FocusRequest.Token="{Binding AddFormFocusToken}"
         infra:FocusRequest.SelectAll="True"
         infra:EnterKeyNavigation.MoveFocusOnEnter="True"/>
                                <TextBlock Text="{Binding FormEntity.ValidationErrors[Id]}"
                                       Style="{StaticResource ErrorText}"
                                       Margin="0,3,0,12"/>

                                <TextBlock Text="Name*"
                                       Style="{StaticResource MonoLabelText}"/>
                                <TextBox x:Name="AddNameTextBox"
         Text="{Binding FormEntity.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         ToolTip="Entity name cannot be empty"
         TabIndex="11"
         infra:EnterKeyNavigation.MoveFocusOnEnter="True"/>
                                <TextBlock Text="{Binding FormEntity.ValidationErrors[Name]}"
                                       Style="{StaticResource ErrorText}"
                                       Margin="0,3,0,12"/>

                                <TextBlock Text="Type*"
                                       Style="{StaticResource MonoLabelText}"/>
                                <ComboBox x:Name="AddTypeComboBox"
          ItemsSource="{Binding AvailableTypes}"
          SelectedItem="{Binding FormEntity.EntityType, Mode=TwoWay}"
          DisplayMemberPath="TypeName"
          ToolTip="Choose Solar Panel or Wind Turbine"
          TabIndex="12"
          infra:EnterKeyNavigation.MoveFocusOnEnter="True"/>
                                <TextBlock Text="{Binding FormEntity.ValidationErrors[EntityType]}"
                                       Style="{StaticResource ErrorText}"
                                       Margin="0,3,0,12"/>

                                <TextBlock Text="Initial measured value MW"
                                       Style="{StaticResource MonoLabelText}"/>
                                <TextBox x:Name="AddMeasurementTextBox"
         Text="{Binding FormEntity.LastMeasurement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         ToolTip="Initial value. Valid range is 1-5 MW."
         TabIndex="13"
         infra:EnterKeyNavigation.MoveFocusOnEnter="True"/>
                                <TextBlock Text="Valid range for DER production is 1-5 MW. Values outside this range are shown as INVALID."
                                       Foreground="{StaticResource UIMutedTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,16"/>

                                <Button Command="{Binding AddCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    ToolTip="Add new DER entity"
                                        TabIndex="14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Add Entity"/>
                                        <Border BorderBrush="{StaticResource UIWhiteBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Margin="8,0,0,0">
                                            <TextBlock Text="Alt+Enter" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Border BorderBrush="{StaticResource UISubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="{StaticResource UIBackgroundBrush}"
                                    Padding="10"
                                    Margin="0,18,0,0">
                                    <TextBlock Text="No MessageBox is used here. Every input has its own validation message, and success/error feedback is displayed through the shell toast."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource UIMutedTextBrush}"
                                           FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= DELETE CONFIRMATION OVERLAY ================= -->
        <Border Background="#66000000">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeleteConfirmationVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Border Width="460"
                        Background="{StaticResource UIPanelBrush}"
                        BorderBrush="{StaticResource UIBorderBrush}"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Confirm delete"
                                   FontFamily="Courier New"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding DeleteConfirmationText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource UIMutedTextBrush}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="This is a custom confirmation overlay, not a MessageBox. The action can be reverted with Ctrl+Z."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource UIMutedTextBrush}"
                                   Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Command="{Binding CancelDeleteCommand}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Delete"
                                    Command="{Binding ConfirmDeleteCommand}"
                                    Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>